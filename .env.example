# Copy to .env, then run make setup-access to generate private local credentials.
# The application starts with an empty project named default. Only live mode exists.
APP_MODE=live
POSTGRES_PASSWORD=
TENDERPROOF_PRINCIPALS_JSON=
LLM_NAME=swiss-ai/Apertus-v1.5-8B
# Actual OpenAI-compatible Apertus endpoint, including /v1.
# It must be reachable from app and worker on the internal Docker network.
# Leave blank to review/upload sources without inference; extraction returns 503.
LLM_BASE_URL=
LLM_API_KEY=
# Per-call HTTP timeout (1-900 seconds); four roles run sequentially per source window.
LLM_TIMEOUT_SECONDS=300
# Optional private raw request/response archives; disabled when blank.
# For local development use an ignored path such as .runtime/inference-traces.
APERTUS_TRACE_DIR=
# setup-access generates one engineer principal for project default and writes
# its token to .runtime/operator_token. Additional authorized roles are configured
# by the operator in TENDERPROOF_PRINCIPALS_JSON; no sample tokens are accepted.
